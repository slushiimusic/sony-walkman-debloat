@@ -0,0 +1,62 @@
+import 'package:classipod/features/settings/controller/battery_settings_controller.dart';
+import 'package:classipod_power/classipod_power.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  group('batteryCarePattern', () {
+    final pattern = RegExp(
+      BatterySettingsController.batteryCarePattern,
+      caseSensitive: false,
+    );
+
+    test('matches likely Battery Care keys', () {
+      for (final key in [
+        'battery_care',
+        'BatteryCare',
+        'somc.battery_care_enabled',
+        'charge_limit',
+        'charging_care',
+        'battery_protection',
+      ]) {
+        expect(pattern.hasMatch(key), isTrue, reason: key);
+      }
+    });
+
+    test('ignores unrelated battery keys', () {
+      for (final key in [
+        'low_power',
+        'battery_percentage',
+        'ble_scan_always_enabled',
+        'stay_on_while_plugged_in',
+        'adaptive_battery_management_enabled',
+      ]) {
+        expect(pattern.hasMatch(key), isFalse, reason: key);
+      }
+    });
+  });
+
+  group('pickBatteryCareSetting', () {
+    test('prefers an on/off key named care', () {
+      final picked = pickBatteryCareSetting({
+        const SystemSetting.global('charge_limit'): '1',
+        const SystemSetting.system('battery_care'): '0',
+      });
+      expect(picked?.key, const SystemSetting.system('battery_care'));
+      expect(picked?.value, '0');
+    });
+
+    test('skips values that are not on/off', () {
+      expect(
+        pickBatteryCareSetting({
+          const SystemSetting.global('charge_limit'): '90',
+          const SystemSetting.global('battery_care_mode'): null,
+        }),
+        isNull,
+      );
+    });
+
+    test('nothing found', () {
+      expect(pickBatteryCareSetting({}), isNull);
+    });
+  });
+}
diff --git a/test/unit_tests/features/status_bar/android_battery_state_test.dart b/test/unit_tests/features/status_bar/android_battery_state_test.dart
new file mode 100644
index 0000000..7a143fb
--- /dev/null
+++ b/test/unit_tests/features/status_bar/android_battery_state_test.dart
@@ -0,0 +1,203 @@
+import 'dart:async';
+
+import 'package:battery_plus/battery_plus.dart';
+import 'package:classipod/features/status_bar/controller/battery_controller.dart';
+import 'package:classipod/features/status_bar/model/android_battery_state.dart';
+import 'package:classipod/features/status_bar/model/battery_model.dart';
+import 'package:classipod_power/classipod_power.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+AndroidBatterySnapshot _snapshot({
+  int level = 50,
+  int status = AndroidBatterySnapshot.statusCharging,
+  int plugged = AndroidBatterySnapshot.pluggedUsb,
+}) {
+  return AndroidBatterySnapshot(level: level, status: status, plugged: plugged);
+}
+
+void main() {
+  group('batteryStateFromAndroid', () {
+    test('unplugged is never charging, even if status says so', () {
+      expect(
+        batteryStateFromAndroid(_snapshot(plugged: 0)),
+        BatteryState.discharging,
+      );
+      expect(
+        batteryStateFromAndroid(
+          _snapshot(plugged: 0, status: AndroidBatterySnapshot.statusFull),
+        ),
+        BatteryState.discharging,
+      );
+    });
+
+    test('plugged in and charging', () {
+      expect(batteryStateFromAndroid(_snapshot()), BatteryState.charging);
+      expect(
+        batteryStateFromAndroid(
+          _snapshot(plugged: AndroidBatterySnapshot.pluggedAc),
+        ),
+        BatteryState.charging,
+      );
+    });
+
+    test('plugged in but idle', () {
+      for (final status in [
+        AndroidBatterySnapshot.statusNotCharging,
+        AndroidBatterySnapshot.statusDischarging,
+        AndroidBatterySnapshot.statusUnknown,
+      ]) {
+        expect(
+          batteryStateFromAndroid(_snapshot(status: status)),
+          BatteryState.connectedNotCharging,
+        );
+      }
+      expect(
+        batteryStateFromAndroid(
+          _snapshot(status: AndroidBatterySnapshot.statusFull),
+        ),
+        BatteryState.full,
+      );
+    });
+
+    test('stalled charge counts as not charging', () {
+      expect(
+        batteryStateFromAndroid(_snapshot(), stalled: true),
+        BatteryState.connectedNotCharging,
+      );
+    });
+
+    test('charge limit reached counts as not charging', () {
+      expect(
+        batteryStateFromAndroid(_snapshot(level: 90), chargeLimit: 90),
+        BatteryState.connectedNotCharging,
+      );
+      expect(
+        batteryStateFromAndroid(_snapshot(level: 89), chargeLimit: 90),
+        BatteryState.charging,
+      );
+      expect(
+        batteryStateFromAndroid(_snapshot(level: -1), chargeLimit: 90),
+        BatteryState.charging,
+      );
+    });
+  });
+
+  group('ChargeProgress', () {
+    final start = DateTime(2026, 10, 3, 12);
+
+    test('rising level keeps charging', () {
+      final progress = ChargeProgress();
+      expect(progress.isStalled(_snapshot(level: 60), start), isFalse);
+      expect(
+        progress.isStalled(
+          _snapshot(level: 61),
+          start.add(const Duration(minutes: 14)),
+        ),
+        isFalse,
+      );
+      expect(
+        progress.isStalled(
+          _snapshot(level: 61),
+          start.add(const Duration(minutes: 28)),
+        ),
+        isFalse,
+      );
+    });
+
+    test('no rise for the stall window is stalled', () {
+      final progress = ChargeProgress();
+      expect(progress.isStalled(_snapshot(level: 90), start), isFalse);
+      expect(
+        progress.isStalled(
+          _snapshot(level: 90),
+          start.add(const Duration(minutes: 15)),
+        ),
+        isTrue,
+      );
+      expect(
+        progress.isStalled(
+          _snapshot(level: 91),
+          start.add(const Duration(minutes: 16)),
+        ),
+        isFalse,
+      );
+    });
+
+    test('falling level while plugged in is stalled at once', () {
+      final progress = ChargeProgress();
+      expect(progress.isStalled(_snapshot(level: 70), start), isFalse);
+      final later = start.add(const Duration(minutes: 1));
+      expect(progress.isStalled(_snapshot(level: 69), later), isTrue);
+      expect(progress.isStalled(_snapshot(level: 69), later), isTrue);
+      expect(
+        progress.isStalled(
+          _snapshot(level: 70),
+          later.add(const Duration(minutes: 3)),
+        ),
+        isFalse,
+      );
+    });
+
+    test('unplugging resets the tracking', () {
+      final progress = ChargeProgress();
+      progress.isStalled(_snapshot(level: 80), start);
+      progress.isStalled(
+        _snapshot(level: 79),
+        start.add(const Duration(minutes: 1)),
+      );
+      expect(
+        progress.isStalled(
+          _snapshot(level: 79, plugged: 0),
+          start.add(const Duration(minutes: 2)),
+        ),
+        isFalse,
+      );
+      expect(
+        progress.isStalled(
+          _snapshot(level: 79),
+          start.add(const Duration(minutes: 3)),
+        ),
+        isFalse,
+      );
+    });
+  });
+
+  group('androidBatteryModels', () {
+    test('seeds from the current state, then follows changes', () async {
+      final changes = StreamController<AndroidBatterySnapshot>.broadcast();
+      final models = <BatteryModel>[];
+      final subscription = androidBatteryModels(
+        current: () async => _snapshot(level: 40),
+        changes: changes.stream,
+      ).listen(models.add);
+      await pumpEventQueue();
+      changes.add(_snapshot(level: 40, plugged: 0));
+      await pumpEventQueue();
+      await subscription.cancel();
+      await changes.close();
+
+      expect(models, const [
+        BatteryModel(level: 40, batteryState: BatteryState.charging),
+        BatteryModel(level: 40, batteryState: BatteryState.discharging),
+      ]);
+    });
+
+    test('applies the charge limit', () async {
+      final models = <BatteryModel>[];
+      final subscription = androidBatteryModels(
+        current: () async => _snapshot(level: 90),
+        changes: const Stream.empty(),
+        chargeLimit: 90,
+      ).listen(models.add);
+      await pumpEventQueue();
+      await subscription.cancel();
+
+      expect(models, const [
+        BatteryModel(
+          level: 90,
+          batteryState: BatteryState.connectedNotCharging,
+        ),
+      ]);
+    });
+  });
+}
