index 0000000..5a3b0f0
--- /dev/null
+++ b/lib/features/status_bar/model/android_battery_state.dart
@@ -0,0 +1,67 @@
+import 'package:battery_plus/battery_plus.dart';
+import 'package:classipod_power/classipod_power.dart';
+
+/// Maps Android's battery broadcast to the state the status bar shows.
+///
+/// The plug flags decide first: with nothing plugged in the battery cannot
+/// be charging, whatever the status field says. A plugged-in battery that
+/// has reached [chargeLimit] (Sony's Battery Care) or has [stalled] is only
+/// being held, so it counts as not charging.
+BatteryState batteryStateFromAndroid(
+  AndroidBatterySnapshot snapshot, {
+  int? chargeLimit,
+  bool stalled = false,
+}) {
+  if (!snapshot.isPluggedIn) return BatteryState.discharging;
+  switch (snapshot.status) {
+    case AndroidBatterySnapshot.statusCharging:
+      final atLimit = chargeLimit != null && snapshot.level >= chargeLimit;
+      if (stalled || atLimit) return BatteryState.connectedNotCharging;
+      return BatteryState.charging;
+    case AndroidBatterySnapshot.statusFull:
+      return BatteryState.full;
+    default:
+      return BatteryState.connectedNotCharging;
+  }
+}
+
+/// Watches whether the level actually rises while Android says "charging".
+///
+/// Android can report charging while USB power is present even though the
+/// battery isn't gaining: held at the Battery Care limit, or with the screen
+/// drawing more than a weak USB port supplies.
+class ChargeProgress {
+  ChargeProgress({this.stallAfter = const Duration(minutes: 15)});
+
+  /// Even a 500 mA port adds 1% in under 5 minutes, so no rise for this
+  /// long means the battery is not gaining charge.
+  final Duration stallAfter;
+
+  int? _level;
+  DateTime? _since;
+  bool _falling = false;
+
+  bool isStalled(AndroidBatterySnapshot snapshot, DateTime now) {
+    if (!snapshot.isPluggedIn ||
+        snapshot.status != AndroidBatterySnapshot.statusCharging ||
+        snapshot.level < 0) {
+      _level = null;
+      _since = null;
+      _falling = false;
+      return false;
+    }
+    final last = _level;
+    if (last == null || snapshot.level > last) {
+      _level = snapshot.level;
+      _since = now;
+      _falling = false;
+      return false;
+    }
+    if (snapshot.level < last) {
+      _level = snapshot.level;
+      _since = now;
+      _falling = true;
+    }
+    return _falling || now.difference(_since!) >= stallAfter;
+  }
+}
