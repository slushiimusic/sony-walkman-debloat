+++ b/lib/features/settings/screens/battery_settings_screen.dart
@@ -0,0 +1,237 @@
+import 'package:battery_plus/battery_plus.dart';
+import 'package:classipod/core/alerts/dialogs.dart';
+import 'package:classipod/core/extensions/build_context_extensions.dart';
+import 'package:classipod/core/extensions/go_router_extensions.dart';
+import 'package:classipod/core/navigation/routes.dart';
+import 'package:classipod/features/custom_screen_elements/custom_screen.dart';
+import 'package:classipod/features/menu/controller/split_screen_controller.dart';
+import 'package:classipod/features/menu/models/split_screen_type.dart';
+import 'package:classipod/features/settings/controller/battery_settings_controller.dart';
+import 'package:classipod/features/settings/models/battery_settings_model.dart';
+import 'package:classipod/features/settings/widgets/settings_list_tile.dart';
+import 'package:classipod/features/status_bar/controller/battery_controller.dart';
+import 'package:cupertino_ui/cupertino_ui.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+enum _BatterySettingsItems {
+  status,
+  batterySaver,
+  batteryCare,
+  bluetoothScanning,
+  screenTimeout,
+  allowChanges;
+
+  String title(BuildContext context) => switch (this) {
+    status => context.localization.batteryStatusTitle,
+    batterySaver => context.localization.batterySaverTitle,
+    batteryCare => context.localization.batteryCareTitle,
+    bluetoothScanning => context.localization.bluetoothScanningTitle,
+    screenTimeout => context.localization.screenTimeoutTitle,
+    allowChanges => context.localization.allowSystemChangesTitle,
+  };
+
+  SplitScreenType get preview => switch (this) {
+    status => SplitScreenType.batteryStatus,
+    batterySaver => SplitScreenType.batterySaver,
+    batteryCare => SplitScreenType.batteryCare,
+    bluetoothScanning => SplitScreenType.bluetoothScanning,
+    screenTimeout => SplitScreenType.screenTimeout,
+    allowChanges => SplitScreenType.allowSystemChanges,
+  };
+}
+
+class BatterySettingsScreen extends ConsumerStatefulWidget {
+  const BatterySettingsScreen({super.key});
+
+  @override
+  ConsumerState<BatterySettingsScreen> createState() =>
+      _BatterySettingsScreenState();
+}
+
+class _BatterySettingsScreenState extends ConsumerState<BatterySettingsScreen>
+    with CustomScreen {
+  late final AppLifecycleListener _lifecycleListener;
+  bool _handlingSetting = false;
+  List<_BatterySettingsItems> _displayItems = _BatterySettingsItems.values;
+
+  @override
+  String get routeName => Routes.batterySettings.name;
+
+  @override
+  List<_BatterySettingsItems> get displayItems => _displayItems;
+
+  @override
+  void initState() {
+    super.initState();
+    // Settings may have changed in the system Battery page.
+    _lifecycleListener = AppLifecycleListener(
+      onResume: () => ref.invalidate(batterySettingsControllerProvider),
+    );
+  }
+
+  @override
+  void dispose() {
+    _lifecycleListener.dispose();
+    super.dispose();
+  }
+
+  @override
+  Future<void> onSelectPressed() =>
+      _settingAction(displayItems[selectedDisplayItem]);
+
+  Future<void> _settingAction(_BatterySettingsItems item) async {
+    if (_handlingSetting) return;
+    _handlingSetting = true;
+    try {
+      setState(() => selectedDisplayItem = displayItems.indexOf(item));
+      final controller = ref.read(batterySettingsControllerProvider.notifier);
+      switch (item) {
+        case _BatterySettingsItems.status:
+          await controller.openBatteryUsage();
+          break;
+        case _BatterySettingsItems.batterySaver:
+          await _showResult(await controller.toggleBatterySaver());
+          break;
+        case _BatterySettingsItems.batteryCare:
+          await _showResult(await controller.toggleBatteryCare());
+          break;
+        case _BatterySettingsItems.bluetoothScanning:
+          await _showResult(await controller.toggleBluetoothScanning());
+          break;
+        case _BatterySettingsItems.screenTimeout:
+          await _showResult(await controller.cycleScreenTimeout());
+          break;
+        case _BatterySettingsItems.allowChanges:
+          await _showPermissionHelp();
+          break;
+      }
+    } finally {
+      _handlingSetting = false;
+    }
+  }
+
+  Future<void> _showResult(SystemSettingChange result) async {
+    if (!mounted) return;
+    switch (result) {
+      case SystemSettingChange.done:
+      case SystemSettingChange.openedSystemScreen:
+        break;
+      case SystemSettingChange.needsPermission:
+        await _showPermissionHelp();
+        break;
+      case SystemSettingChange.failed:
+        await Dialogs.showInfoDialog(
+          context: context,
+          title: context.localization.batterySettingsScreenTitle,
+          content: context.localization.systemSettingChangeFailed,
+        );
+        break;
+    }
+  }
+
+  Future<void> _showPermissionHelp() async {
+    final settings = await ref.read(batterySettingsControllerProvider.future);
+    if (!mounted) return;
+    await Dialogs.showInfoDialog(
+      context: context,
+      title: context.localization.allowSystemChangesTitle,
+      content: context.localization.allowSystemChangesDescription(
+        settings.packageName,
+      ),
+    );
+  }
+
+  void _changeSplitScreenType() {
+    if (!mounted || context.router.locationNamed != routeName) return;
+    ref.read(splitScreenControllerProvider.notifier).changeSplitScreenType =
+        displayItems[selectedDisplayItem].preview;
+  }
+
+  String? _statusValue(BatteryState? state) => switch (state) {
+    BatteryState.charging => context.localization.batteryStatusCharging,
+    BatteryState.full => context.localization.batteryStatusCharged,
+    BatteryState.connectedNotCharging =>
+      context.localization.batteryStatusNotCharging,
+    BatteryState.discharging => context.localization.batteryStatusOnBattery,
+    BatteryState.unknown || null => null,
+  };
+
+  String? _onOff(bool? value) {
+    if (value == null) return null;
+    return value
+        ? context.localization.tileValueOn
+        : context.localization.tileValueOff;
+  }
+
+  String? _timeoutValue(Duration? timeout) {
+    if (timeout == null) return null;
+    if (timeout.inSeconds < 60) {
+      return context.localization.screenTimeoutSeconds(timeout.inSeconds);
+    }
+    return context.localization.screenTimeoutMinutes(timeout.inMinutes);
+  }
+
+  String? _value(
+    _BatterySettingsItems item,
+    BatterySettingsModel? settings,
+    BatteryState? batteryState,
+  ) => switch (item) {
+    _BatterySettingsItems.status => _statusValue(batteryState),
+    _BatterySettingsItems.batterySaver => _onOff(settings?.batterySaver),
+    _BatterySettingsItems.batteryCare => _onOff(settings?.batteryCare),
+    _BatterySettingsItems.bluetoothScanning => _onOff(
+      settings?.bluetoothScanning,
+    ),
+    _BatterySettingsItems.screenTimeout => _timeoutValue(
+      settings?.screenTimeout,
+    ),
+    _BatterySettingsItems.allowChanges => null,
+  };
+
+  @override
+  Widget build(BuildContext context) {
+    final settings = ref.watch(batterySettingsControllerProvider).value;
+    final batteryState = ref
+        .watch(batteryDetailsControllerProvider)
+        .value
+        ?.batteryState;
+    final selectedItem = displayItems[selectedDisplayItem];
+    _displayItems = [
+      for (final item in _BatterySettingsItems.values)
+        if (item != _BatterySettingsItems.allowChanges ||
+            settings?.canWriteSettings == false)
+          item,
+    ];
+    final selectedIndex = displayItems.indexOf(selectedItem);
+    selectedDisplayItem = selectedIndex < 0 ? 0 : selectedIndex;
+    _changeSplitScreenType();
+
+    return CupertinoPageScaffold(
+      resizeToAvoidBottomInset: false,
+      child: Column(
+        children: [
+          Flexible(
+            child: CupertinoScrollbar(
+              controller: scrollController,
+              child: ListView.builder(
+                controller: scrollController,
+                itemCount: displayItems.length,
+                prototypeItem: SettingsListTile(
+                  text: '',
+                  isSelected: false,
+                  onTap: () {},
+                ),
+                itemBuilder: (context, index) => SettingsListTile(
+                  text: displayItems[index].title(context),
+                  value: _value(displayItems[index], settings, batteryState),
+                  isSelected: selectedDisplayItem == index,
+                  onTap: () async => _settingAction(displayItems[index]),
+                ),
+              ),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
