diff --git a/lib/features/settings/controller/battery_settings_controller.dart b/lib/features/settings/controller/battery_settings_controller.dart
new file mode 100644
index 0000000..47bc53f
--- /dev/null
+++ b/lib/features/settings/controller/battery_settings_controller.dart
@@ -0,0 +1,160 @@
+import 'dart:io';
+
+import 'package:classipod/features/settings/models/battery_settings_model.dart';
+import 'package:classipod_power/classipod_power.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+enum SystemSettingChange { done, needsPermission, openedSystemScreen, failed }
+
+final batterySettingsControllerProvider =
+    AsyncNotifierProvider<BatterySettingsController, BatterySettingsModel>(
+      BatterySettingsController.new,
+    );
+
+/// Sony's Battery Care stops charging at about 90%.
+final batteryCareChargeLimitProvider = Provider<int?>((ref) {
+  if (kIsWeb || !Platform.isAndroid) return null;
+  final settings = ref.watch(batterySettingsControllerProvider).value;
+  return settings?.batteryCare == true ? 90 : null;
+});
+
+class BatterySettingsController extends AsyncNotifier<BatterySettingsModel> {
+  static const _batterySaver = SystemSetting.global('low_power');
+  static const _bluetoothScanning = SystemSetting.global(
+    'ble_scan_always_enabled',
+  );
+  static const _screenTimeout = SystemSetting.system('screen_off_timeout');
+
+  /// Sony doesn't document where Battery Care lives, so look for it.
+  static const batteryCarePattern =
+      r'batt(ery)?[^a-z]?care|charg(e|ing)[^a-z]?(limit|care)|'
+      r'battery[^a-z]?protect';
+
+  static const screenTimeouts = [
+    Duration(seconds: 15),
+    Duration(seconds: 30),
+    Duration(minutes: 1),
+    Duration(minutes: 2),
+    Duration(minutes: 5),
+    Duration(minutes: 10),
+  ];
+
+  @override
+  Future<BatterySettingsModel> build() async {
+    final values = await ClassipodPower.getSettings([
+      _bluetoothScanning,
+      _screenTimeout,
+    ]);
+    final batteryCare = pickBatteryCareSetting(
+      await ClassipodPower.findSettings(batteryCarePattern),
+    );
+    final timeout = int.tryParse(values[_screenTimeout] ?? '');
+    return BatterySettingsModel(
+      packageName: await ClassipodPower.packageName(),
+      canWriteSettings: await ClassipodPower.canWriteSecureSettings(),
+      batterySaver: await ClassipodPower.isPowerSaveMode(),
+      batteryCareSetting: batteryCare?.key,
+      batteryCare: batteryCare == null ? null : batteryCare.value == '1',
+      bluetoothScanning: values[_bluetoothScanning] != '0',
+      screenTimeout: timeout == null ? null : Duration(milliseconds: timeout),
+    );
+  }
+
+  Future<SystemSettingChange> toggleBatterySaver() async {
+    final current = await future;
+    final enabled = !current.batterySaver;
+    return _write(
+      _batterySaver,
+      enabled ? '1' : '0',
+      current.copyWith(batterySaver: enabled),
+    );
+  }
+
+  /// Flips the setting found by the scan. Otherwise, or when the system
+  /// refuses the write, opens Sony's Battery page instead.
+  Future<SystemSettingChange> toggleBatteryCare() async {
+    final current = await future;
+    final setting = current.batteryCareSetting;
+    final enabled = current.batteryCare;
+    if (setting == null || enabled == null) return _openBatteryScreen();
+    final result = await _write(
+      setting,
+      enabled ? '0' : '1',
+      current.copyWith(batteryCare: !enabled),
+    );
+    if (result == SystemSettingChange.needsPermission &&
+        setting.namespace == 'system') {
+      // Private keys in the system table stay read-only to apps, even
+      // with the adb grant.
+      return _openBatteryScreen();
+    }
+    return result;
+  }
+
+  Future<SystemSettingChange> toggleBluetoothScanning() async {
+    final current = await future;
+    final enabled = !current.bluetoothScanning;
+    return _write(
+      _bluetoothScanning,
+      enabled ? '1' : '0',
+      current.copyWith(bluetoothScanning: enabled),
+    );
+  }
+
+  Future<SystemSettingChange> cycleScreenTimeout() async {
+    final current = await future;
+    final index = screenTimeouts.indexOf(
+      current.screenTimeout ?? Duration.zero,
+    );
+    final next = screenTimeouts[(index + 1) % screenTimeouts.length];
+    return _write(
+      _screenTimeout,
+      next.inMilliseconds.toString(),
+      current.copyWith(screenTimeout: next),
+    );
+  }
+
+  Future<void> openBatteryUsage() => ClassipodPower.openSystemScreen('battery');
+
+  Future<SystemSettingChange> _openBatteryScreen() async {
+    return await ClassipodPower.openSystemScreen('battery')
+        ? SystemSettingChange.openedSystemScreen
+        : SystemSettingChange.failed;
+  }
+
+  /// Shows [updated] straight away: the system applies some settings
+  /// asynchronously, and the screen re-reads everything on resume.
+  Future<SystemSettingChange> _write(
+    SystemSetting setting,
+    String value,
+    BatterySettingsModel updated,
+  ) async {
+    try {
+      if (!await ClassipodPower.putSetting(setting, value)) {
+        return SystemSettingChange.failed;
+      }
+    } on PlatformException catch (e) {
+      return e.code == 'PERMISSION_DENIED'
+          ? SystemSettingChange.needsPermission
+          : SystemSettingChange.failed;
+    }
+    state = AsyncData(updated);
+    return SystemSettingChange.done;
+  }
+}
+
+/// The likeliest Battery Care switch among [found]: an on/off value, and
+/// preferably a name that says "care".
+MapEntry<SystemSetting, String?>? pickBatteryCareSetting(
+  Map<SystemSetting, String?> found,
+) {
+  final switches = found.entries
+      .where((entry) => entry.value == '0' || entry.value == '1')
+      .toList();
+  for (final entry in switches) {
+    if (entry.key.key.toLowerCase().contains('care')) return entry;
+  }
+  return switches.isEmpty ? null : switches.first;
+}
