+/// Status bar state from Android's battery broadcast.
+///
+/// [current] seeds the state because [changes] is shared and only replays
+/// the sticky broadcast to its first listener. The state is re-checked every
+/// [recheckEvery] so a stalled charge shows even without new broadcasts.
+Stream<BatteryModel> androidBatteryModels({
+  required Future<AndroidBatterySnapshot> Function() current,
+  required Stream<AndroidBatterySnapshot> changes,
+  int? chargeLimit,
+  Duration recheckEvery = const Duration(minutes: 1),
+  DateTime Function() clock = DateTime.now,
+}) {
+  final progress = ChargeProgress();
+  StreamSubscription<AndroidBatterySnapshot>? subscription;
+  Timer? timer;
+  AndroidBatterySnapshot? latest;
+  late final StreamController<BatteryModel> controller;
+
+  void emit(AndroidBatterySnapshot snapshot) {
+    latest = snapshot;
+    controller.add(
+      BatteryModel(
+        level: snapshot.level.clamp(0, 100),
+        batteryState: batteryStateFromAndroid(
+          snapshot,
+          chargeLimit: chargeLimit,
+          stalled: progress.isStalled(snapshot, clock()),
+        ),
+      ),
+    );
+  }
+
+  void startTimer() {
+    timer = Timer.periodic(recheckEvery, (_) {
+      final snapshot = latest;
+      if (snapshot != null) emit(snapshot);
     });
+  }
+
+  controller = StreamController<BatteryModel>(
+    onListen: () {
+      subscription = changes.listen(emit, onError: controller.addError);
+      unawaited(
+        current().then((snapshot) {
+          if (latest == null) emit(snapshot);
+        }, onError: controller.addError),
+      );
+      startTimer();
+    },
+    onPause: () => timer?.cancel(),
+    onResume: startTimer,
+    onCancel: () async {
+      timer?.cancel();
+      await subscription?.cancel();
+    },
+  );
+  return controller.stream.distinct();
+}
+
+/// Platforms other than Android. Level is re-read on each state change.
+Stream<BatteryModel> _batteryPlusModels() async* {
+  final battery = Battery();
+  Future<BatteryModel> read() async => BatteryModel(
+    level: await battery.batteryLevel,
+    batteryState: await battery.batteryState,
+  );
+  yield await read();
+  await for (final _ in battery.onBatteryStateChanged.handleError((_) {})) {
+    yield await read();
+  }
+}
diff --git a/lib/features/status_bar/model/android_battery_state.dart b/lib/features/status_bar/model/android_battery_state.dart
