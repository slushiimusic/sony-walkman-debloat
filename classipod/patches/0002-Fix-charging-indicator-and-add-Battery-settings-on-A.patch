@@ -0,0 +1,80 @@
+import 'package:classipod_power/classipod_power.dart';
+
+class BatterySettingsModel {
+  const BatterySettingsModel({
+    required this.packageName,
+    required this.canWriteSettings,
+    required this.batterySaver,
+    required this.batteryCareSetting,
+    required this.batteryCare,
+    required this.bluetoothScanning,
+    required this.screenTimeout,
+  });
+
+  final String packageName;
+
+  /// Whether WRITE_SECURE_SETTINGS has been granted over adb.
+  final bool canWriteSettings;
+
+  final bool batterySaver;
+
+  /// Where this firmware stores Battery Care, if the settings scan found it.
+  final SystemSetting? batteryCareSetting;
+
+  /// Null when Battery Care could not be located.
+  final bool? batteryCare;
+
+  final bool bluetoothScanning;
+
+  final Duration? screenTimeout;
+
+  BatterySettingsModel copyWith({
+    bool? canWriteSettings,
+    bool? batterySaver,
+    bool? batteryCare,
+    bool? bluetoothScanning,
+    Duration? screenTimeout,
+  }) {
+    return BatterySettingsModel(
+      packageName: packageName,
+      canWriteSettings: canWriteSettings ?? this.canWriteSettings,
+      batterySaver: batterySaver ?? this.batterySaver,
+      batteryCareSetting: batteryCareSetting,
+      batteryCare: batteryCare ?? this.batteryCare,
+      bluetoothScanning: bluetoothScanning ?? this.bluetoothScanning,
+      screenTimeout: screenTimeout ?? this.screenTimeout,
+    );
+  }
+
+  @override
+  bool operator ==(Object other) {
+    return other is BatterySettingsModel &&
+        other.packageName == packageName &&
+        other.canWriteSettings == canWriteSettings &&
+        other.batterySaver == batterySaver &&
+        other.batteryCareSetting == batteryCareSetting &&
+        other.batteryCare == batteryCare &&
+        other.bluetoothScanning == bluetoothScanning &&
+        other.screenTimeout == screenTimeout;
+  }
+
+  @override
+  int get hashCode => Object.hash(
+    packageName,
+    canWriteSettings,
+    batterySaver,
+    batteryCareSetting,
+    batteryCare,
+    bluetoothScanning,
+    screenTimeout,
+  );
+
+  @override
+  String toString() {
+    return 'BatterySettingsModel(canWriteSettings: $canWriteSettings, '
+        'batterySaver: $batterySaver, batteryCareSetting: '
+        '$batteryCareSetting, batteryCare: $batteryCare, '
+        'bluetoothScanning: $bluetoothScanning, '
+        'screenTimeout: $screenTimeout)';
+  }
+}
