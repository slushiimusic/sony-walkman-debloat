--- /dev/null
+++ b/packages/classipod_power/android/src/main/kotlin/com/adeeteya/classipod/power/ClassipodPowerPlugin.kt
@@ -0,0 +1,248 @@
+package com.adeeteya.classipod.power
+
+import android.Manifest
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.BatteryManager
+import android.os.Build
+import android.os.PowerManager
+import android.provider.Settings
+import io.flutter.embedding.engine.plugins.FlutterPlugin
+import io.flutter.plugin.common.EventChannel
+import io.flutter.plugin.common.MethodCall
+import io.flutter.plugin.common.MethodChannel
+
+/**
+ * Battery and power settings for Classipod.
+ *
+ * Battery state comes from the sticky ACTION_BATTERY_CHANGED broadcast, the
+ * same source the system status bar uses, because it carries the plug flags
+ * as well as the status. battery_plus only asks the battery HAL for
+ * BATTERY_PROPERTY_STATUS, bypassing the framework.
+ */
+class ClassipodPowerPlugin :
+    FlutterPlugin,
+    MethodChannel.MethodCallHandler,
+    EventChannel.StreamHandler {
+    private var context: Context? = null
+    private var methodChannel: MethodChannel? = null
+    private var batteryChannel: EventChannel? = null
+    private var batteryReceiver: BroadcastReceiver? = null
+
+    override fun onAttachedToEngine(binding: FlutterPlugin.FlutterPluginBinding) {
+        context = binding.applicationContext
+        methodChannel = MethodChannel(binding.binaryMessenger, "classipod/power")
+            .also { it.setMethodCallHandler(this) }
+        batteryChannel = EventChannel(binding.binaryMessenger, "classipod/power/battery")
+            .also { it.setStreamHandler(this) }
+    }
+
+    override fun onDetachedFromEngine(binding: FlutterPlugin.FlutterPluginBinding) {
+        stopBatteryUpdates()
+        methodChannel?.setMethodCallHandler(null)
+        methodChannel = null
+        batteryChannel?.setStreamHandler(null)
+        batteryChannel = null
+        context = null
+    }
+
+    override fun onMethodCall(call: MethodCall, result: MethodChannel.Result) {
+        val ctx = context
+        if (ctx == null) {
+            result.error("UNAVAILABLE", "Plugin is detached", null)
+            return
+        }
+        when (call.method) {
+            "getBattery" -> {
+                val intent = registerBatteryReceiver(ctx, null)
+                if (intent == null) {
+                    result.error("UNAVAILABLE", "No battery broadcast yet", null)
+                } else {
+                    result.success(batterySnapshot(intent))
+                }
+            }
+
+            "getPackageName" -> result.success(ctx.packageName)
+
+            "canWriteSecureSettings" -> result.success(canWriteSecureSettings(ctx))
+
+            "isPowerSaveMode" -> {
+                val power = ctx.getSystemService(Context.POWER_SERVICE) as PowerManager
+                result.success(power.isPowerSaveMode)
+            }
+
+            "getSettings" -> {
+                val keys = call.argument<List<Map<String, String>>>("keys").orEmpty()
+                result.success(keys.associate { entry ->
+                    val namespace = entry["namespace"].orEmpty()
+                    val key = entry["key"].orEmpty()
+                    "$namespace/$key" to readSetting(ctx, namespace, key)
+                })
+            }
+
+            "findSettings" -> {
+                val pattern = call.argument<String>("pattern").orEmpty()
+                result.success(findSettings(ctx, Regex(pattern, RegexOption.IGNORE_CASE)))
+            }
+
+            "openSystemScreen" -> {
+                val action = when (call.argument<String>("screen")) {
+                    "battery" -> Intent.ACTION_POWER_USAGE_SUMMARY
+                    "batterySaver" -> Settings.ACTION_BATTERY_SAVER_SETTINGS
+                    else -> Settings.ACTION_SETTINGS
+                }
+                result.success(startSettingsActivity(ctx, action))
+            }
+
+            "putSetting" -> {
+                val namespace = call.argument<String>("namespace").orEmpty()
+                val key = call.argument<String>("key").orEmpty()
+                val value = call.argument<String>("value")
+                try {
+                    result.success(writeSetting(ctx, namespace, key, value))
+                } catch (e: SecurityException) {
+                    result.error("PERMISSION_DENIED", e.message, null)
+                } catch (e: IllegalArgumentException) {
+                    // SettingsProvider rejects private keys without the grant.
+                    result.error("PERMISSION_DENIED", e.message, null)
+                }
+            }
+
+            else -> result.notImplemented()
+        }
+    }
+
+    override fun onListen(arguments: Any?, events: EventChannel.EventSink) {
+        val ctx = context
+        if (ctx == null) {
+            events.error("UNAVAILABLE", "Plugin is detached", null)
+            return
+        }
+        stopBatteryUpdates()
+        val receiver = object : BroadcastReceiver() {
+            override fun onReceive(context: Context, intent: Intent) {
+                events.success(batterySnapshot(intent))
+            }
+        }
+        batteryReceiver = receiver
+        // The broadcast is sticky, so the receiver gets the current value
+        // straight away.
+        registerBatteryReceiver(ctx, receiver)
+    }
+
+    override fun onCancel(arguments: Any?) {
+        stopBatteryUpdates()
+    }
+
+    private fun stopBatteryUpdates() {
+        val receiver = batteryReceiver ?: return
+        batteryReceiver = null
+        try {
+            context?.unregisterReceiver(receiver)
+        } catch (_: IllegalArgumentException) {
+            // Already unregistered.
+        }
+    }
+
+    private fun registerBatteryReceiver(ctx: Context, receiver: BroadcastReceiver?): Intent? {
+        val filter = IntentFilter(Intent.ACTION_BATTERY_CHANGED)
+        return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+            ctx.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED)
+        } else {
+            ctx.registerReceiver(receiver, filter)
+        }
+    }
+
+    private fun batterySnapshot(intent: Intent): Map<String, Int> {
+        val level = intent.getIntExtra(BatteryManager.EXTRA_LEVEL, -1)
+        val scale = intent.getIntExtra(BatteryManager.EXTRA_SCALE, -1)
+        return mapOf(
+            "level" to if (level >= 0 && scale > 0) Math.round(level * 100f / scale) else -1,
+            "status" to intent.getIntExtra(
+                BatteryManager.EXTRA_STATUS,
+                BatteryManager.BATTERY_STATUS_UNKNOWN,
+            ),
+            "plugged" to intent.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0),
+        )
+    }
+
+    private fun canWriteSecureSettings(ctx: Context): Boolean =
+        ctx.checkSelfPermission(Manifest.permission.WRITE_SECURE_SETTINGS) ==
+            PackageManager.PERMISSION_GRANTED
+
+    private fun readSetting(ctx: Context, namespace: String, key: String): String? {
+        val resolver = ctx.contentResolver
+        return try {
+            when (namespace) {
+                "global" -> Settings.Global.getString(resolver, key)
+                "secure" -> Settings.Secure.getString(resolver, key)
+                "system" -> Settings.System.getString(resolver, key)
+                else -> null
+            }
+        } catch (_: SecurityException) {
+            null
+        }
+    }
+
+    /** Every row of the three settings tables whose name matches. */
+    private fun findSettings(ctx: Context, name: Regex): List<Map<String, String?>> {
+        val tables = mapOf(
+            "global" to Settings.Global.CONTENT_URI,
+            "secure" to Settings.Secure.CONTENT_URI,
+            "system" to Settings.System.CONTENT_URI,
+        )
+        val found = mutableListOf<Map<String, String?>>()
+        for ((namespace, uri) in tables) {
+            found += try {
+                queryTable(ctx, uri, namespace, name)
+            } catch (_: RuntimeException) {
+                // Android 12+ refuses whole-table reads from apps.
+                emptyList()
+            }
+        }
+        return found
+    }
+
+    private fun queryTable(
+        ctx: Context,
+        uri: Uri,
+        namespace: String,
+        name: Regex,
+    ): List<Map<String, String?>> {
+        val rows = mutableListOf<Map<String, String?>>()
+        val projection = arrayOf(Settings.NameValueTable.NAME, Settings.NameValueTable.VALUE)
+        ctx.contentResolver.query(uri, projection, null, null, null)?.use { cursor ->
+            while (cursor.moveToNext()) {
+                val key = cursor.getString(0) ?: continue
+                if (name.containsMatchIn(key)) {
+                    rows += mapOf("namespace" to namespace, "key" to key, "value" to cursor.getString(1))
+                }
+            }
+        }
+        return rows
+    }
+
+    private fun startSettingsActivity(ctx: Context, action: String): Boolean {
+        val intent = Intent(action).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        return try {
+            ctx.startActivity(intent)
+            true
+        } catch (_: RuntimeException) {
+            false
+        }
+    }
+
+    private fun writeSetting(ctx: Context, namespace: String, key: String, value: String?): Boolean {
+        val resolver = ctx.contentResolver
+        return when (namespace) {
+            "global" -> Settings.Global.putString(resolver, key, value)
+            "secure" -> Settings.Secure.putString(resolver, key, value)
+            "system" -> Settings.System.putString(resolver, key, value)
+            else -> false
+        }
+    }
+}
diff --git a/packages/classipod_power/lib/classipod_power.dart b/packages/classipod_power/lib/classipod_power.dart
new file mode 100644
index 0000000..230ec24
--- /dev/null
+++ b/packages/classipod_power/lib/classipod_power.dart
@@ -0,0 +1,173 @@
+import 'package:flutter/services.dart';
+
+/// Values from Android's `ACTION_BATTERY_CHANGED` broadcast.
+class AndroidBatterySnapshot {
+  const AndroidBatterySnapshot({
+    required this.level,
+    required this.status,
+    required this.plugged,
+  });
+
+  factory AndroidBatterySnapshot.fromMap(Map<Object?, Object?> map) {
+    return AndroidBatterySnapshot(
+      level: map['level'] as int? ?? -1,
+      status: map['status'] as int? ?? statusUnknown,
+      plugged: map['plugged'] as int? ?? 0,
+    );
+  }
+
+  // BatteryManager.BATTERY_STATUS_*
+  static const int statusUnknown = 1;
+  static const int statusCharging = 2;
+  static const int statusDischarging = 3;
+  static const int statusNotCharging = 4;
+  static const int statusFull = 5;
+
+  // BatteryManager.BATTERY_PLUGGED_*
+  static const int pluggedAc = 1;
+  static const int pluggedUsb = 2;
+  static const int pluggedWireless = 4;
+  static const int pluggedDock = 8;
+
+  /// Charge in percent, or -1 when the system did not report it.
+  final int level;
+
+  /// One of the `status*` constants.
+  final int status;
+
+  /// Bitmask of the `plugged*` constants; 0 means running on battery.
+  final int plugged;
+
+  bool get isPluggedIn => plugged != 0;
+
+  @override
+  bool operator ==(Object other) {
+    return other is AndroidBatterySnapshot &&
+        other.level == level &&
+        other.status == status &&
+        other.plugged == plugged;
+  }
+
+  @override
+  int get hashCode => Object.hash(level, status, plugged);
+
+  @override
+  String toString() {
+    return 'AndroidBatterySnapshot(level: $level, status: $status, '
+        'plugged: $plugged)';
+  }
+}
+
+/// A row in Android's settings provider.
+class SystemSetting {
+  const SystemSetting.global(this.key) : namespace = 'global';
+  const SystemSetting.secure(this.key) : namespace = 'secure';
+  const SystemSetting.system(this.key) : namespace = 'system';
+  const SystemSetting._(this.namespace, this.key);
+
+  final String namespace;
+  final String key;
+
+  String get id => '$namespace/$key';
+
+  Map<String, String> toMap() => {'namespace': namespace, 'key': key};
+
+  @override
+  bool operator ==(Object other) {
+    return other is SystemSetting &&
+        other.namespace == namespace &&
+        other.key == key;
+  }
+
+  @override
+  int get hashCode => Object.hash(namespace, key);
+
+  @override
+  String toString() => id;
+}
+
+/// Android-only. Calls fail with [MissingPluginException] elsewhere.
+class ClassipodPower {
+  const ClassipodPower._();
+
+  static const MethodChannel _methods = MethodChannel('classipod/power');
+  static const EventChannel _batteryEvents = EventChannel(
+    'classipod/power/battery',
+  );
+
+  static Future<AndroidBatterySnapshot> battery() async {
+    final map = await _methods.invokeMapMethod<Object?, Object?>('getBattery');
+    return AndroidBatterySnapshot.fromMap(map ?? const {});
+  }
+
+  /// Every system battery update, starting with the current state for the
+  /// first listener. Shared, because an event channel can only feed one
+  /// native subscription.
+  static final Stream<AndroidBatterySnapshot> batteryChanges = _batteryEvents
+      .receiveBroadcastStream()
+      .map(
+        (event) =>
+            AndroidBatterySnapshot.fromMap(event as Map<Object?, Object?>),
+      );
+
+  static Future<String> packageName() async {
+    return await _methods.invokeMethod<String>('getPackageName') ?? '';
+  }
+
+  /// Whether WRITE_SECURE_SETTINGS has been granted with `adb shell pm grant`.
+  static Future<bool> canWriteSecureSettings() async {
+    return await _methods.invokeMethod<bool>('canWriteSecureSettings') ?? false;
+  }
+
+  static Future<bool> isPowerSaveMode() async {
+    return await _methods.invokeMethod<bool>('isPowerSaveMode') ?? false;
+  }
+
+  static Future<Map<SystemSetting, String?>> getSettings(
+    Iterable<SystemSetting> settings,
+  ) async {
+    final list = settings.toList();
+    final values = await _methods.invokeMapMethod<String, String?>(
+      'getSettings',
+      {
+        'keys': [for (final setting in list) setting.toMap()],
+      },
+    );
+    return {for (final setting in list) setting: values?[setting.id]};
+  }
+
+  /// Settings whose key matches [pattern], case-insensitively, with their
+  /// current values. Empty on Android 12 and later, which block the scan.
+  static Future<Map<SystemSetting, String?>> findSettings(
+    String pattern,
+  ) async {
+    final rows =
+        await _methods.invokeListMethod<Map<Object?, Object?>>('findSettings', {
+          'pattern': pattern,
+        }) ??
+        const [];
+    return {
+      for (final row in rows)
+        SystemSetting._(row['namespace']! as String, row['key']! as String):
+            row['value'] as String?,
+    };
+  }
+
+  /// Opens a system settings page. [screen] is `battery` or `batterySaver`.
+  static Future<bool> openSystemScreen(String screen) async {
+    return await _methods.invokeMethod<bool>('openSystemScreen', {
+          'screen': screen,
+        }) ??
+        false;
+  }
+
+  /// Throws a [PlatformException] with code `PERMISSION_DENIED` when the
+  /// system refuses the write.
+  static Future<bool> putSetting(SystemSetting setting, String? value) async {
+    return await _methods.invokeMethod<bool>('putSetting', {
+          ...setting.toMap(),
+          'value': value,
+        }) ??
+        false;
+  }
+}
