+package com.adeeteya.classipod.power
+
+import android.app.Activity
+import android.content.Intent
+import android.os.Bundle
+
+/**
+ * The HOME entry point. It brings up Classipod's normal activity and
+ * finishes, so the Flutter activity never runs in the home task. That keeps
+ * a single activity on audio_service's shared engine, even when the media
+ * notification opens the app.
+ */
+class HomeActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        packageManager.getLaunchIntentForPackage(packageName)?.let { launch ->
+            launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+            launch.putExtra(EXTRA_HOME_PRESSED, true)
+            startActivity(launch)
+        }
+        finish()
+        @Suppress("DEPRECATION")
+        overridePendingTransition(0, 0)
+    }
+
+    companion object {
+        const val EXTRA_HOME_PRESSED = "com.adeeteya.classipod.power.HOME_PRESSED"
+    }
+}
