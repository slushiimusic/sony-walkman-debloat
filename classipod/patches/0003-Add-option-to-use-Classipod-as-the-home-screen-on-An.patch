+import 'dart:io';
+
+import 'package:classipod/core/extensions/go_router_extensions.dart';
+import 'package:classipod/core/navigation/routes.dart';
+import 'package:classipod_power/classipod_power.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/widgets.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+/// Whether Classipod is the Android home app.
+final homeScreenControllerProvider =
+    AsyncNotifierProvider<HomeScreenController, bool>(HomeScreenController.new);
+
+class HomeScreenController extends AsyncNotifier<bool> {
+  @override
+  Future<bool> build() async {
+    if (kIsWeb || !Platform.isAndroid) return false;
+    // The default home app can also be changed in system settings.
+    final lifecycle = AppLifecycleListener(onResume: ref.invalidateSelf);
+    ref.onDispose(lifecycle.dispose);
+    return ClassipodPower.isDefaultHome();
+  }
+
+  Future<void> toggle() async {
+    final enabled = await future;
+    state = AsyncData(await ClassipodPower.setHomeScreen(!enabled));
+  }
+}
+
+/// Pressing Home while Classipod is the home app goes back to the menu.
+final homePressedHandlerProvider = Provider<void>((ref) {
+  if (kIsWeb || !Platform.isAndroid) return;
+  final router = ref.watch(routerProvider);
+  ClassipodPower.setHomePressedHandler(() {
+    if (router.locationNamed == Routes.splash.name) return;
+    router.goNamed(Routes.menu.name);
+  });
+  ref.onDispose(() => ClassipodPower.setHomePressedHandler(null));
+});
